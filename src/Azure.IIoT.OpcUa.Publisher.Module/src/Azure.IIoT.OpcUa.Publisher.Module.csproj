<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <Nullable>enable</Nullable>
    <TieredPGO>true</TieredPGO>
    <!--
      Phase 8b: opt the Module into the shared Native-AOT / trim analyzer profile
      (see src/Directory.Build.targets) via IIoTNativeAot, which turns on
      IsAotCompatible, IsTrimmable and the trim / AOT / single-file Roslyn
      analyzers for every build (not just the AOT publish) so trim / AOT
      incompatibilities in the Module and its reachable dependencies surface as
      warnings during a normal `dotnet build`. The native publish itself stays
      gated behind IIoTPublishAot.
    -->
    <IIoTNativeAot>true</IIoTNativeAot>
    <!--
      Enable the minimal API Request Delegate Generator (interceptor based source
      generator) for every build so the MapGet/MapPost endpoint registrations in
      Endpoints/PublisherApiEndpoints.cs are generated at compile time instead of
      through the reflection based RequestDelegateFactory. This removes the bulk
      of the minimal-API binding trim/AOT warnings. The JSON body (de)serialization
      still flows through the shared reflection based serializer (Core Json with the
      DataContractResolver.Modify contract modifier), whose entry points are
      RequiresUnreferencedCode/RequiresDynamicCode annotated; moving the REST DTO
      graph onto a source generated JSON context is the final AOT flip (see 8b).
    -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <!--
    Opt into Native-AOT publish via `-p:IIoTPublishAot=true` rather than
    `-p:PublishAot=true`. The switch is what selects the AOT *configuration*, not
    merely the toolchain: it compiles the MCP tool server out of the image (see
    the IIOT_MCP property below), so it must stay a distinct property even though
    the stack is now consumed as packages rather than as multi-TFM projects.
      dotnet publish ...Module.csproj -c Release -r linux-x64 -p:IIoTPublishAot=true (self-contained)

    Native-AOT compiles to a real target binary, so it cannot cross an OS boundary:
    publishing a linux RID from Windows fails with "Cross-OS native compilation is
    not supported". Build the linux images from a Linux host (or a Linux SDK
    container - the `-aot` SDK tags carry the clang/zlib prerequisites).

    linux-arm64 additionally needs the aarch64 cross toolchain, because ILC links
    through clang with an aarch64-linux-gnu target and the bfd linker:
      apt-get install binutils-aarch64-linux-gnu gcc-aarch64-linux-gnu libc6-dev-arm64-cross
      dotnet publish ...Module.csproj -c Release -r linux-arm64 -p:IIoTPublishAot=true \
        -p:ObjCopyName=aarch64-linux-gnu-objcopy
    Do not pass -p:SysRoot - those packages install into clang's default target
    search path, and the libc linker scripts hold absolute paths that a sysroot
    prefix would resolve a second time ("cannot find libm.so.6 inside ...").

    Add `-t:PublishContainer -p:ContainerArchiveOutputPath=<file>.tar.gz` to emit the
    distroless image as an OCI archive that `docker load` accepts.
  -->
  <PropertyGroup Condition="'$(IIoTPublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <!--
    The OPC UA MCP tool server cannot work in an ahead-of-time published module:
    the MCP SDK builds every tool's input schema reflectively, and the diagnostics
    tools additionally sit on SharpPcap and reflective packet dissection. Referencing
    them anyway would add trim/AOT warnings and drag native capture dependencies into
    a binary that can never use them, so the whole feature is compiled out of the AOT
    configuration and the `mcp` flag fails fast there instead. See docs/opc-publisher/mcp.md.
  -->
  <PropertyGroup Condition="'$(IIoTPublishAot)' != 'true'">
    <DefineConstants>$(DefineConstants);IIOT_MCP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <ContainerRepository>iotedge/opc-publisher</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-azurelinux3.0-distroless</ContainerBaseImage>
  </PropertyGroup>
  <ItemGroup>
    <ContainerEnvironmentVariable Include="ASPNETCORE_HTTP_PORTS" Value="" />
    <ContainerEnvironmentVariable Include="DOTNET_ReadyToRun" Value="0" />
    <ContainerEnvironmentVariable Include="DOTNET_TieredPGO" Value="1" />
    <ContainerEnvironmentVariable Include="DOTNET_TC_QuickJitForLoops" Value="1" />
  </ItemGroup>
  <ItemGroup>
    <ContainerPort Include="9071" Type="tcp" />
    <ContainerPort Include="9072" Type="tcp" />
    <ContainerPort Include="80" Type="tcp" />
    <ContainerPort Include="443" Type="tcp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectCapability Include="AzureIoTEdgeModule" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="pki\**" />
    <EmbeddedResource Remove="pki\**" />
    <None Remove="pki\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(IIoTPublishAot)' != 'true'">
    <!--
      The OPC UA MCP tool libraries, excluded entirely from the AOT
      configuration (see the IIOT_MCP property above).
    -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Mcp.Core" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Mcp.Diagnostics" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Azure.IIoT.OpcUa.Core\src\Azure.IIoT.OpcUa.Core.csproj" />
    <ProjectReference Include="..\..\Azure.IIoT.OpcUa.Publisher\src\Azure.IIoT.OpcUa.Publisher.csproj" />
    <ProjectReference Include="..\..\Azure.IIoT.OpcUa.Core\generator\Azure.IIoT.OpcUa.Core.Rpc.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
