<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <!--
      OPC Publisher 3.0 core: the single owned foundation project that replaces
      the Furly NuGet dependencies (serializers, messaging, storage, IoT Edge +
      tunnel, AspNetCore helpers). System.Text.Json only; Native-AOT + trim clean.
    -->
    <IIoTNativeAot>true</IIoTNativeAot>
    <!--
      SYSLIB1104: the configuration binding source generator cannot emit binding
      for the intentional generic Configuration.Get<T>() in PostConfigureOptionBase
      (reflection fallback, flagged AOT-unsafe via Requires* attributes there).
    -->
    <NoWarn>$(NoWarn);SYSLIB1104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.ExceptionSummarization" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>
