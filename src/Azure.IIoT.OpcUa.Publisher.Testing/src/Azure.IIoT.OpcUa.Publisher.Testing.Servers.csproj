    <PackageReference Include="Newtonsoft.Json" />
    <!--
      Phase 8 (AOT gate): pin the multi-TFM UA-.NETStandard submodule reference to
      net10.0 and stop PublishAot from propagating so a `-p:PublishAot=true` publish
      of a consumer does not build it for net472 etc. (NETSDK1207). Do NOT modify the
      submodule csprojs.
    -->
    <ProjectReference Include="..\..\..\external\UA-.NETStandard\Libraries\Opc.Ua.Server\Opc.Ua.Server.csproj"
                      SetTargetFramework="TargetFramework=net10.0"
                      UndefineProperties="PublishAot" />
  </ItemGroup>
