<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.ResourceMonitoring" />
    <PackageReference Include="Nito.AsyncEx" />
    <PackageReference Include="Azure.Iot.Operations.Connector" />
    <PackageReference Include="Azure.Iot.Operations.Services" />
    <PackageReference Include="Irony" />
    <!--
      Phase 8 (AOT gate): pin these multi-TFM UA-.NETStandard submodule references to
      net10.0 and stop PublishAot from propagating into them (and their transitive
      analyzer/source-generator projects) so `dotnet publish -p:PublishAot=true` does
      not build them for net472 etc. and fail with NETSDK1207. Do NOT modify the
      submodule csprojs.
    -->
    <ProjectReference Include="..\..\..\external\UA-.NETStandard\Libraries\Opc.Ua.Client.ComplexTypes\Opc.Ua.Client.ComplexTypes.csproj"
                      SetTargetFramework="TargetFramework=net10.0"
                      UndefineProperties="PublishAot" />
    <ProjectReference Include="..\..\..\external\UA-.NETStandard\Libraries\Opc.Ua.Client\Opc.Ua.Client.csproj"
                      SetTargetFramework="TargetFramework=net10.0"
                      UndefineProperties="PublishAot" />
    <ProjectReference Include="..\..\..\external\UA-.NETStandard\Libraries\Opc.Ua.PubSub\Opc.Ua.PubSub.csproj"
                      SetTargetFramework="TargetFramework=net10.0"
                      UndefineProperties="PublishAot" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Azure.IIoT.OpcUa.Core\src\Azure.IIoT.OpcUa.Core.csproj" />
    <ProjectReference Include="..\..\Azure.IIoT.OpcUa\src\Azure.IIoT.OpcUa.csproj" />
  </ItemGroup>
</Project>
